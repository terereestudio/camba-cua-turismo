# Cabeceras de seguridad - Netlify (Camba Cua Turismo)
# Aplicar cabeceras base a todo el sitio
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin

# CSP para la portada celular (scripts inline con hash)
/
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-MJ1dzDZD5jUZhCewSoF9Io/Lih2Nao+BEAk0a6aPMDY=' 'sha256-49OmSwvBl3v63uoPmxhELj+qfWbBYwG9shJ/2nJCScE=' https://www.instagram.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.instagram.com; frame-src https://www.instagram.com; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests

/index.html
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-MJ1dzDZD5jUZhCewSoF9Io/Lih2Nao+BEAk0a6aPMDY=' 'sha256-49OmSwvBl3v63uoPmxhELj+qfWbBYwG9shJ/2nJCScE=' https://www.instagram.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.instagram.com; frame-src https://www.instagram.com; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# CSP para la versión escritorio
/escritorio.html
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-PxuT+q2+1qmCeAKFefPlEVPzLJ9gjDNxyfWvBcvpoSE=' https://www.instagram.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.instagram.com; frame-src https://www.instagram.com; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests
